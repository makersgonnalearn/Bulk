# Copy this file to .env in the repository root and fill in the server values.
# The API loads this file before initializing; environment variables provided by
# the VM or process manager take precedence over values here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use SUPABASE_PUBLISHABLE_KEY instead of SUPABASE_ANON_KEY if preferred.
# SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
PYTHON_EXECUTABLE=python3
# Set PORT only when your VM does not provide it.
# PORT=8080
# Docker Compose host port (defaults to 8080).
# APP_PORT=8080

# Private development preview only; the API ignores these unless NODE_ENV=development.
# Never enable the development login bypass in a production deployment.
DEV_SKIP_LOGIN=false
DEV_LOGIN_EMAIL=